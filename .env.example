# Copy to .env and fill in. Never commit the result.
#
#   cp .env.example .env
#
# The browser extension never reads this file and never holds a secret: it
# talks to the API, and the API holds the keys.

# --- app ---
ENVIRONMENT=development
DEBUG=false
API_PORT=8000

# --- security ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production. Left unset in development a random key is generated
# per process, which means every restart logs everybody out.
SECRET_KEY=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# --- database ---
POSTGRES_USER=stockwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stockwatch
POSTGRES_PORT=5432
# Set automatically inside docker compose; only needed when running locally.
# DATABASE_URL=postgresql+psycopg://stockwatch:change-me@localhost:5432/stockwatch

# --- redis / celery ---
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379/0

# --- rate limiting ---
RATE_LIMIT_ENABLED=true
# Counters are per-process by default, so with more than one API container a
# limit of N is really N per container. Point this at Redis when you scale out:
# RATE_LIMIT_STORAGE_URI=redis://redis:6379/1
RATE_LIMIT_STORAGE_URI=memory://
AUTH_REGISTER_LIMIT=5/hour
AUTH_LOGIN_LIMIT=10/minute;100/hour
AUTH_REFRESH_LIMIT=60/hour
# Turn on ONLY behind a proxy you control that overwrites X-Forwarded-For.
# Otherwise a client can forge the header and appear as thousands of addresses.
TRUST_PROXY_HEADERS=false

# --- monitoring ---
# Minutes between checks of a healthy product. Be kind: these are requests to
# somebody else's shop, and nothing in retail moves fast enough to justify
# polling every few minutes.
CHECK_INTERVAL_MINUTES=60
IDLE_CHECK_INTERVAL_MINUTES=360
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3
# Minimum seconds between two requests to the same host, across all users.
PER_HOST_DELAY_SECONDS=3
MAX_CONSECUTIVE_FAILURES=8
RESPECT_ROBOTS_TXT=true

# --- email (Resend) ---
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=StockWatch <alerts@yourdomain.com>
NOTIFICATION_COOLDOWN_MINUTES=60

# --- cors ---
# The extension's origin is chrome-extension://<id>, which is not known until
# it is installed, so a wildcard is used and matched as a regex.
CORS_ORIGINS=chrome-extension://*,http://localhost:5173
