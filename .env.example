# Copy to .env and fill in. Never commit the result.
#
#   cp .env.example .env
#
# The browser extension never reads this file and never holds a secret: it
# talks to the API, and the API holds the keys.

# --- app ---
ENVIRONMENT=development
DEBUG=false
API_PORT=8000
# Production only (docker-compose.prod.yml): the hostname Caddy gets a
# certificate for, and the one the extension is built against. Its A record must
# already point at the host. See docs/deploy.md.
# API_DOMAIN=api.yourdomain.com

# --- security ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production. Left unset in development a random key is generated
# per process, which means every restart logs everybody out.
SECRET_KEY=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# --- database ---
POSTGRES_USER=stockwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stockwatch
POSTGRES_PORT=5432
# Set automatically inside docker compose; only needed when running locally.
# DATABASE_URL=postgresql+psycopg://stockwatch:change-me@localhost:5432/stockwatch

# Connections are per process, and there are several: two uvicorn workers, a
# Celery worker and beat. A managed Postgres usually allows far fewer than the
# total these multiply out to, so they default low. Raise them on a database
# you own; lower them, or use DB_DISABLE_POOLING, on a small managed plan.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=10
# Required by most hosted providers. Leave unset for a database on the same
# host or the same private network as the API.
# DB_SSLMODE=require
# Set when something else already pools — PgBouncer in transaction mode, or a
# provider's pooled endpoint. Holding connections open fights that pooler.
# DB_DISABLE_POOLING=false

# --- redis / celery ---
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379/0

# --- rate limiting ---
RATE_LIMIT_ENABLED=true
# Counters are per-process by default, so with more than one API container a
# limit of N is really N per container. Point this at Redis when you scale out:
# RATE_LIMIT_STORAGE_URI=redis://redis:6379/1
RATE_LIMIT_STORAGE_URI=memory://
AUTH_REGISTER_LIMIT=5/hour
AUTH_LOGIN_LIMIT=10/minute;100/hour
AUTH_REFRESH_LIMIT=60/hour
# Turn on ONLY behind a proxy you control that overwrites X-Forwarded-For.
# Otherwise a client can forge the header and appear as thousands of addresses.
TRUST_PROXY_HEADERS=false

# --- monitoring ---
# Minutes between checks of a healthy product. Be kind: these are requests to
# somebody else's shop, and nothing in retail moves fast enough to justify
# polling every few minutes.
CHECK_INTERVAL_MINUTES=60
IDLE_CHECK_INTERVAL_MINUTES=360
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3
# Minimum seconds between two requests to the same host, across all users.
PER_HOST_DELAY_SECONDS=3
MAX_CONSECUTIVE_FAILURES=8
RESPECT_ROBOTS_TXT=true

# Refuse to fetch URLs that resolve to a non-public address. The URL is the
# user's and the network is ours, so without this anyone can make the worker
# read cloud instance metadata or anything else on the private network. Leave
# it on. Redirects are checked hop by hop, and a body over the ceiling is
# abandoned mid-read rather than held in memory.
FETCH_GUARD_ENABLED=true
MAX_REDIRECTS=5
MAX_RESPONSE_BYTES=5000000

# --- discord bot ---
# From the Discord developer portal, Bot tab. Leave empty to run without a bot;
# webhooks and every other alert channel work regardless. Start it with:
#   docker compose --profile discord up -d
DISCORD_BOT_TOKEN=
# How long a link code stays valid, and how often the bot looks for alerts to
# deliver. The poll hits our own database, never Discord.
DISCORD_LINK_CODE_MINUTES=15
DISCORD_POLL_SECONDS=20

# --- account recovery ---
# Codes are emailed and pasted back into the extension; there is no website to
# land on. Short for a reset, since the user is looking at their inbox already.
PASSWORD_RESET_MINUTES=30
EMAIL_VERIFY_HOURS=48
# Require a verified address before monitoring runs. Off so a deployment
# without email still works; turn it ON in production, where an unverified
# signup is somebody else's address carrying your monitoring bill.
REQUIRE_EMAIL_VERIFICATION=false
AUTH_FORGOT_PASSWORD_LIMIT=5/hour
AUTH_VERIFY_EMAIL_LIMIT=5/hour

# --- email (Resend) ---
# Setting the key is enough: email turns itself on when one is present, because
# two switches for one intention is one too many. Set EMAIL_ENABLED explicitly
# only to override that — e.g. to keep the key while sending is paused.
RESEND_API_KEY=
# EMAIL_ENABLED=false
# Must be a domain verified in Resend, or every send is rejected. The default
# in code ends in .local and is refused in production for exactly that reason.
EMAIL_FROM=StockWatch <alerts@yourdomain.com>
NOTIFICATION_COOLDOWN_MINUTES=60

# --- cors ---
# The extension's origin is chrome-extension://<id>, which is not known until
# it is installed, so a wildcard is used and matched as a regex.
CORS_ORIGINS=chrome-extension://*,http://localhost:5173
